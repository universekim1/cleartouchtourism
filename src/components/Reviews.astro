---
// Verbatim quotes from real Google reviews (see testimonials in site.ts).
import { site, testimonials } from "../data/site";
interface Props { eyebrow?: string; title?: string; }
const { eyebrow = "Loved by our guests", title = "What our guests say" } = Astro.props;
---
<section class="section section--navy" id="reviews">
  <div class="container">
    <div class="section-head">
      <p class="eyebrow">{eyebrow}</p>
      <h2 class="h-display">{title}</h2>
      <p>Rated <b>5.0</b> <span class="rating">★★★★★</span> on Google.</p>
    </div>
    <div class="tgrid">
      {testimonials.map((t) => (
        <div class="tcard">
          <div class="stars">★★★★★</div>
          <blockquote>“{t.quote}”</blockquote>
          <div class="tcard__who">
            <div class="avatar">{t.initial}</div>
            <div><b>{t.name}</b><span>{t.place}</span></div>
          </div>
        </div>
      ))}
    </div>
    <p class="treviews-link">
      <a href={site.googleMapsUrl} target="_blank" rel="noopener">Read all our reviews on Google →</a>
    </p>
  </div>
</section>
